* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: "Microsoft YaHei", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: #333;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    min-height: 100vh;
    padding: 15px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    width: 100%;
    max-width: 1200px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    overflow: hidden;
}

header {
    background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    color: white;
    padding: 20px;
    text-align: center;
}

h1 {
    font-size: 1.8rem;
    margin-bottom: 5px;
}

.subtitle {
    font-size: 0.9rem;
    opacity: 0.9;
}

.main-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.training-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
}

.mode-section {
    flex: 1;
    min-width: 300px;
    background: #f8f9fa;
    border-radius: 10px;
    padding: 20px;
    border: 2px solid #dee2e6;
}

.mode-title {
    font-size: 1.2rem;
    font-weight: bold;
    color: #6a11cb;
    margin-bottom: 15px;
    text-align: center;
}

.test-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 15px;
}

.test-option {
    padding: 10px 15px;
    background: #e9ecef;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid #dee2e6;
    flex: 1;
    min-width: 80px;
    text-align: center;
}

.test-option:hover {
    background: #dee2e6;
}

.test-option.selected {
    background: #6a11cb;
    color: white;
    border-color: #6a11cb;
}

.mode-description {
    font-size: 0.85rem;
    color: #6c757d;
    margin-top: 10px;
    line-height: 1.4;
}

.custom-selection {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    margin-top: 15px;
}

.formula-option {
    padding: 8px 5px;
    background: #e9ecef;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid #dee2e6;
    text-align: center;
}

.formula-option:hover {
    background: #dee2e6;
}

.formula-option.selected {
    background: #6a11cb;
    color: white;
    border-color: #6a11cb;
}

.custom-controls {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 15px;
}

.color-selection {
    display: flex;
    align-items: center;
    gap: 15px;
}

.color-option {
    padding: 5px 10px;
    background: #e9ecef;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid #dee2e6;
}

.color-option.selected {
    background: #6a11cb;
    color: white;
    border-color: #6a11cb;
}

.times-selection {
    display: flex;
    align-items: center;
    gap: 10px;
}

#timesInput {
    width: 60px;
    padding: 5px;
    border: 1px solid #dee2e6;
    border-radius: 5px;
    text-align: center;
}

.start-button-container {
    text-align: center;
    margin-top: 20px;
}

button {
    padding: 12px 30px;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

#startTest {
    background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%);
    color: white;
}

button:hover {
    transform: translateY(-3px);
    box-shadow: 0 7px 10px rgba(0, 0, 0, 0.15);
}

button:active {
    transform: translateY(1px);
}

.reference-data {
    background: #e9ecef;
    padding: 15px;
    border-radius: 10px;
    margin-top: 20px;
}

.reference-data h3 {
    margin-bottom: 10px;
    color: #6a11cb;
}

.reference-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 5px;
}

/* 测试界面样式 */
.test-screen {
    padding: 20px;
}

.top-section {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-bottom: 20px;
}

.image-container {
    flex: 1;
    background: #f8f9fa;
    border-radius: 10px;
    padding: 20px;
    text-align: center;
    border: 2px dashed #dee2e6;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 300px;
}

#pllImage {
    max-width: 100%;
    max-height: 250px;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.info-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.attempts {
    text-align: center;
    padding: 10px;
    background: #e9ecef;
    border-radius: 8px;
    color: #6c757d;
    font-weight: bold;
}

#answer {
    font-size: 1.5rem;
    font-weight: bold;
    text-align: center;
    padding: 15px;
    border-radius: 10px;
    background: #e9ecef;
    transition: all 0.3s ease;
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.answer-visible {
    background: #d4edda !important;
    color: #155724;
    border: 1px solid #c3e6cb;
}

.answer-wrong {
    background: #f8d7da !important;
    color: #721c24;
    border: 1px solid #f5c6cb;
}

.time-display {
    text-align: center;
    font-size: 1.2rem;
    font-weight: bold;
    color: #6a11cb;
}

.options-container {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    margin-top: 10px;
    margin-bottom: 20px;
}

.option-btn {
    padding: 10px 5px;
    font-size: 0.9rem;
    font-weight: 600;
    border: 2px solid #dee2e6;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    background: white;
    color: #333;
}

.option-btn:hover {
    background: #e9ecef;
    transform: translateY(-2px);
}

.option-btn.correct {
    background: #28a745;
    color: white;
    border-color: #28a745;
}

.option-btn.wrong {
    background: #dc3545;
    color: white;
    border-color: #dc3545;
}

.option-btn.disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.controls {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 10px;
}

#pauseTest {
    background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    color: white;
}

#endTest {
    background: linear-gradient(135deg, #ff6b6b 0%, #ffa8a8 100%);
    color: white;
}

.stats {
    display: flex;
    justify-content: space-around;
    background: #f8f9fa;
    padding: 15px;
    border-radius: 10px;
    margin-top: 10px;
    text-align: center;
}

.stat-item {
    flex: 1;
}

.stat-value {
    font-size: 1.5rem;
    font-weight: bold;
    color: #6a11cb;
}

.stat-label {
    font-size: 0.9rem;
    color: #6c757d;
}

/* 报告界面样式 */
.report-screen {
    padding: 20px;
    text-align: center;
}

.report-title {
    font-size: 1.8rem;
    margin-bottom: 20px;
    color: #6a11cb;
}

.report-summary {
    background: #f8f9fa;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
}

.accuracy-note {
    font-size: 0.9rem;
    color: #6c757d;
    margin-top: 10px;
    font-style: italic;
}

.report-details {
    text-align: left;
    background: #f8f9fa;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
    max-height: 400px;
    overflow-y: auto;
}

.question-result {
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 1px solid #dee2e6;
}

.question-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.attempt-item {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    border-bottom: 1px dashed #e9ecef;
}

.wrong-image-container {
    display: flex;
    justify-content: center;
    margin-top: 10px;
}

.wrong-image {
    max-width: 150px;
    max-height: 150px;
    border-radius: 8px;
    border: 1px solid #ddd;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.comparison {
    background: #e9ecef;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
}

.report-controls {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 20px;
}

#wrongQuestionsTrain {
    background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
    color: white;
}

#restartTest {
    background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    color: white;
}

footer {
    text-align: center;
    padding: 15px;
    background: #f8f9fa;
    color: #6c757d;
    font-size: 0.9rem;
}

.hidden {
    display: none !important;
}

.paused-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
    border-radius: 15px;
}

.paused-message {
    background: white;
    padding: 30px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
}

.paused-message h2 {
    color: #6a11cb;
    margin-bottom: 15px;
}

#resumeTest {
    background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%);
    color: white;
    margin-top: 15px;
}

.loading-spinner {
    padding: 20px;
    text-align: center;
    color: #6a11cb;
    font-weight: bold;
}

/* 加载动画 */
@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.loading-spinner::before {
    content: "";
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #6a11cb;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-right: 10px;
}

@media (max-width: 768px) {
    .training-modes {
        flex-direction: column;
    }
    
    .top-section {
        flex-direction: column;
    }

    .options-container {
        grid-template-columns: repeat(4, 1fr);
    }

    .image-container {
        min-height: 250px;
    }

    #pllImage {
        max-height: 200px;
    }

    .custom-selection {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (max-width: 480px) {
    .options-container {
        grid-template-columns: repeat(3, 1fr);
    }

    .image-container {
        min-height: 200px;
    }

    #pllImage {
        max-height: 150px;
    }

    .stats {
        flex-direction: column;
        gap: 10px;
    }
    
    .custom-selection {
        grid-template-columns: repeat(3, 1fr);
    }
}
